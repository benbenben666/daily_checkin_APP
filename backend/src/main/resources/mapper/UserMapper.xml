<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ben.daily_check_in.mapper.UserMapper">

    <insert id="insert">
        INSERT INTO `user` (`phone`, `password`, `nickname`)
        VALUES (#{phone}, #{password}, #{nickname})
    </insert>

    <select id="selectById" resultType="User">
        SELECT * FROM `user` WHERE `id` = #{id}
    </select>

    <select id="selectByPhone" resultType="User">
        SELECT * FROM `user` WHERE `phone` = #{phone}
    </select>

    <!-- 列表昵称批量填充专用：只取 id/nickname，避免把 password 哈希读进内存 -->
    <select id="selectByIds" resultType="User">
        SELECT `id`, `nickname` FROM `user`
        WHERE `id` IN
        <foreach collection="ids" item="uid" open="(" separator="," close=")">
            #{uid}
        </foreach>
    </select>

    <update id="updateNickname">
        UPDATE `user` SET `nickname` = #{nickname} WHERE `id` = #{id}
    </update>

    <!-- 行锁：把同一用户的并发申请串行化，保证「每天 3 次」的计数准确 -->
    <select id="lockById" resultType="long">
        SELECT `id` FROM `user` WHERE `id` = #{id} FOR UPDATE
    </select>

    <update id="updatePassword">
        UPDATE `user` SET `password` = #{password} WHERE `id` = #{id}
    </update>

    <update id="updateAvatar">
        UPDATE `user` SET `avatar_key` = #{avatarKey} WHERE `id` = #{id}
    </update>

    <update id="updateStatus">
        UPDATE `user` SET `status` = #{status} WHERE `id` = #{id}
    </update>

    <update id="updateSystemRole">
        UPDATE `user` SET `system_role` = #{systemRole} WHERE `id` = #{id}
    </update>

    <select id="selectAll" resultType="User">
        SELECT * FROM `user`
        <where>
            <if test="keyword != null and keyword != ''">
                (`phone` LIKE CONCAT('%', #{keyword}, '%')
                 OR `nickname` LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY `id`
    </select>

</mapper>
